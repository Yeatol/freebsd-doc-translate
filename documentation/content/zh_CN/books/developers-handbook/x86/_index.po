msgid ""
".c:\n"
"\tcmp\tal, 'c'\n"
"\tjne\tnear usage\n"
"\tor\tah, ah\n"
"\tje\tnear usage\n"
"\tmov\tdh, ah\n"
"\tjmp\t.arg\n"
msgstr ".c:\n\tcmp\tal, 'c'\n\tjne\tnear usage\n\tor\tah, ah\n\tje\tnear usage\n\tmov\tdh, ah\n\tjmp\t.arg\n"

#. type: delimited block . 4
#: documentation/content/en/books/developers-handbook/x86/_index.adoc:2487
#, no-wrap, fuzzy
msgid ""
"align 4\n"
".init:\n"
"\tsub\teax, eax\n"
"\tsub\tebx, ebx\n"
"\tsub\tecx, ecx\n"
"\tmov\tedi, obuffer\n"
msgstr "align 4\n.init:\n\tsub\teax, eax\n\tsub\tebx, ebx\n\tsub\tecx, ecx\n\tmov\tedi, obuffer\n"

#. type: delimited block . 4
#: documentation/content/en/books/developers-handbook/x86/_index.adoc:2491
#, no-wrap, fuzzy
msgid ""
"\t; See if we are to preserve the first line\n"
"\tor\tedx, edx\n"
"\tjs\t.loop\n"
msgstr "\t; See if we are to preserve the first line\n\tor\tedx, edx\n\tjs\t.loop\n"

#. type: delimited block . 4
#: documentation/content/en/books/developers-handbook/x86/_index.adoc:2497
#, no-wrap, fuzzy
msgid ""
".firstline:\n"
