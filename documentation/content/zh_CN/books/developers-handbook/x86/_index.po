"\tjmp\t.arg\n"
msgstr ".p:\n\tcmp\tal, 'p'\n\tjne\t.t\n\tor\tah, ah\n\tjne\tnear usage\n\tor\tedx, 1 << 31\n\tjmp\t.arg\n"

#. type: delimited block . 4
#: documentation/content/en/books/developers-handbook/x86/_index.adoc:2472
#, no-wrap, fuzzy
msgid ""
".t:\n"
"\tcmp\tal, 't'\t\t; redefine output delimiter\n"
"\tjne\t.c\n"
"\tor\tah, ah\n"
"\tje\tnear usage\n"
"\tmov\tdl, ah\n"
"\tjmp\t.arg\n"
msgstr ".t:\n\tcmp\tal, 't'\t\t; redefine output delimiter\n\tjne\t.c\n\tor\tah, ah\n\tje\tnear usage\n\tmov\tdl, ah\n\tjmp\t.arg\n"

#. type: delimited block . 4
#: documentation/content/en/books/developers-handbook/x86/_index.adoc:2480
