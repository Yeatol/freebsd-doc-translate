"#include <netinet/in.h>\n"
msgstr "/*\n * daytimed - a port 13 server\n *\n * Programmed by G. Adam Stanislav\n * June 19, 2001\n */\n#include <stdio.h>\n#include <string.h>\n#include <time.h>\n#include <unistd.h>\n#include <sys/types.h>\n#include <sys/socket.h>\n#include <netinet/in.h>\n"

#. type: delimited block . 4
#: documentation/content/en/books/developers-handbook/sockets/_index.adoc:718
#, no-wrap, fuzzy
msgid "#define BACKLOG 4\n"
msgstr "#define BACKLOG 4\n"

#. type: delimited block . 4
#: documentation/content/en/books/developers-handbook/sockets/_index.adoc:726
#, no-wrap, fuzzy
msgid ""
"int main() {\n"
"    int s, c;\n"
"    socklen_t b;\n"
"    struct sockaddr_in sa;\n"
"    time_t t;\n"
"    struct tm *tm;\n"
"    FILE *client;\n"
msgstr "int main() {\n    int s, c;\n    socklen_t b;\n    struct sockaddr_in sa;\n    time_t t;\n    struct tm *tm;\n    FILE *client;\n"

#. type: delimited block . 4
#: documentation/content/en/books/developers-handbook/sockets/_index.adoc:731
#, no-wrap, fuzzy
msgid ""
"    if ((s = socket(PF_INET, SOCK_STREAM, 0)) < 0) {\n"
"        perror(\"socket\");\n"
"        return 1;\n"
"    }\n"
