"            tm->tm_hour,\n"
"            tm->tm_min,\n"
"            tm->tm_sec);\n"
msgstr "        tm = gmtime(&t);\n        fprintf(client, \"%.4i-%.2i-%.2iT%.2i:%.2i:%.2iZ\\n\",\n            tm->tm_year + 1900,\n            tm->tm_mon + 1,\n            tm->tm_mday,\n            tm->tm_hour,\n            tm->tm_min,\n            tm->tm_sec);\n"

#. type: delimited block . 4
