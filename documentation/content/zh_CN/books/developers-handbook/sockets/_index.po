#. type: delimited block . 4
#: documentation/content/en/books/developers-handbook/sockets/_index.adoc:775
#, no-wrap, fuzzy
msgid ""
"        if ((t = time(NULL)) < 0) {\n"
"            perror(\"daytimed time\");\n"
"            return 6;\n"
"        }\n"
msgstr "        if ((t = time(NULL)) < 0) {\n            perror(\"daytimed time\");\n            return 6;\n        }\n"

#. type: delimited block . 4
#: documentation/content/en/books/developers-handbook/sockets/_index.adoc:784
#, no-wrap, fuzzy
msgid ""
"        tm = gmtime(&t);\n"
