#. type: delimited block . 4
#: documentation/content/en/books/developers-handbook/sockets/_index.adoc:755
#, no-wrap, fuzzy
msgid ""
"    switch (fork()) {\n"
"        case -1:\n"
"            perror(\"fork\");\n"
"            return 3;\n"
"        default:\n"
"            close(s);\n"
"            return 0;\n"
"        case 0:\n"
"            break;\n"
"    }\n"
msgstr "    switch (fork()) {\n        case -1:\n            perror(\"fork\");\n            return 3;\n        default:\n            close(s);\n            return 0;\n        case 0:\n            break;\n    }\n"

#. type: delimited block . 4
#: documentation/content/en/books/developers-handbook/sockets/_index.adoc:757
#, no-wrap, fuzzy
msgid "    listen(s, BACKLOG);\n"
msgstr "    listen(s, BACKLOG);\n"

#. type: delimited block . 4
#: documentation/content/en/books/developers-handbook/sockets/_index.adoc:760
#, no-wrap, fuzzy
