#. type: Plain text
#: documentation/content/en/books/developers-handbook/ipv6/_index.adoc:656
#, fuzzy
msgid "never touch __ss_family. cast to sockaddr * and use sa_family like:"
msgstr "绝不直接访问 __ss_family。将其转换为 sockaddr *，并像下面这样使用 sa_family："

#. type: delimited block . 4
#: documentation/content/en/books/developers-handbook/ipv6/_index.adoc:661
#, no-wrap, fuzzy
msgid ""
"\tstruct sockaddr_storage ss;\n"
"\tfamily = ((struct sockaddr *)&ss)->sa_family\n"
msgstr "\tstruct sockaddr_storage ss;\n\tfamily = ((struct sockaddr *)&ss)->sa_family\n"

#. type: Title ===
#: documentation/content/en/books/developers-handbook/ipv6/_index.adoc:663
#, no-wrap
msgid "Network Drivers"
