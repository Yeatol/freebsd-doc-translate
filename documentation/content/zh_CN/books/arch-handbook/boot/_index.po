"\tmovl\t%cr4, %eax\n"
"\torl\t$CR4_VME, %eax\n"
"\tmovl\t%eax, %cr4\n"

#. type: Plain text
#: documentation/content/en/books/arch-handbook/boot/_index.adoc:1309
#, fuzzy
msgid "Then, enabling paging:"
msgstr "然后启用分页："

#. type: delimited block . 4
#: documentation/content/en/books/arch-handbook/boot/_index.adoc:1319
#, fuzzy, no-wrap
msgid ""
"sys/i386/i386/mpboot.s:\n"
