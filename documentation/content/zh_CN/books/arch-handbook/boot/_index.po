"\tmov\t%ax, %fs\n"
"\tmov\t%ax, %gs\n"
msgstr "/*\n * Don't trust what the BIOS gives for %fs and %gs.  Trust the bootstrap\n * to set %cs, %ds, %es and %ss.\n */\n\tmov\t%ds, %ax\n\tmov\t%ax, %fs\n\tmov\t%ax, %gs\n"

#. type: Plain text
#: documentation/content/en/books/arch-handbook/boot/_index.adoc:1283
#, fuzzy
msgid ""
