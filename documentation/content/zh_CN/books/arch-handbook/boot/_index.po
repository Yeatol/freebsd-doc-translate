#. type: delimited block . 4
#: documentation/content/en/books/arch-handbook/boot/_index.adoc:1604
#, no-wrap, fuzzy
msgid ""
"sys/kern/init_main.c:\n"
"  SET_DECLARE(sysinit_set, struct sysinit);\n"
msgstr "sys/kern/init_main.c:\n  SET_DECLARE(sysinit_set, struct sysinit);\n"

#. type: Plain text
#: documentation/content/en/books/arch-handbook/boot/_index.adoc:1607
#, fuzzy
msgid "The `struct sysinit` is defined as follows:"
