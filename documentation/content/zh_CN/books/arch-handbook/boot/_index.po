#. type: delimited block . 4
#: documentation/content/en/books/arch-handbook/boot/_index.adoc:1271
#, no-wrap, fuzzy
msgid ""
"sys/i386/i386/locore.s:\n"
"/* Don't trust what the BIOS gives for eflags. */\n"
"\tpushl\t$PSL_KERNEL\n"
"\tpopfl\n"
msgstr "sys/i386/i386/locore.s:\n/* Don't trust what the BIOS gives for eflags. */\n\tpushl\t$PSL_KERNEL\n\tpopfl\n"

#. type: delimited block . 4
#: documentation/content/en/books/arch-handbook/boot/_index.adoc:1279
#, no-wrap, fuzzy
msgid ""
"/*\n"
