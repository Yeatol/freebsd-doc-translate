#, no-wrap, fuzzy
msgid ""
"#include <sys/types.h>\n"
"#include <sys/systm.h>  /* uprintf */\n"
"#include <sys/errno.h>\n"
"#include <sys/param.h>  /* defines used in kernel.h */\n"
