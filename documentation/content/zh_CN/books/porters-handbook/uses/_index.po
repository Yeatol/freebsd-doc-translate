msgstr "`PYTEST_ENABLE_BROKEN_TESTS`"

#. type: Plain text
#: documentation/content/en/books/porters-handbook/uses/_index.adoc:2345
#, fuzzy
msgid "Enable tests which are otherwise ignored by `PYTEST_BROKEN_TESTS`."
