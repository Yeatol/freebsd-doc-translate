msgstr "`RUBY_VER`"

#. type: delimited block = 4
#: documentation/content/en/books/porters-handbook/uses/_index.adoc:2474
#, fuzzy
msgid "Alternative short version of ruby in the form of `x.y'."
msgstr "以 `x.y' 的形式指定 Ruby 的备用短版本。"

#. type: Labeled list
#: documentation/content/en/books/porters-handbook/uses/_index.adoc:2475
#, no-wrap, fuzzy
msgid "`RUBY_DEFAULT_VER`"
msgstr "`RUBY_DEFAULT_VER`"

#. type: delimited block = 4
#: documentation/content/en/books/porters-handbook/uses/_index.adoc:2477
#, fuzzy
