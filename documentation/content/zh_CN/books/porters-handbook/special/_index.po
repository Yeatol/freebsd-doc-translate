#: documentation/content/en/books/porters-handbook/special/_index.adoc:1507
#, no-wrap, fuzzy
msgid ""
"USES=\t\tgl xorg\n"
"USE_GL=\t\tglu\n"
"USE_XORG=\txrender xft xkbfile xt xaw\n"
msgstr "USES=\t\tgl xorg\nUSE_GL=\t\tglu\nUSE_XORG=\txrender xft xkbfile xt xaw\n"

#. type: Block title
#: documentation/content/en/books/porters-handbook/special/_index.adoc:1512
