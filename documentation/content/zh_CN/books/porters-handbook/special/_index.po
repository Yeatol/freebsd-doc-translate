#. type: Table
#: documentation/content/en/books/porters-handbook/special/_index.adoc:2487
#, no-wrap, fuzzy
msgid "`QMAKE_ARGS`"
msgstr "`QMAKE_ARGS`"

#. type: Table
#: documentation/content/en/books/porters-handbook/special/_index.adoc:2489
#, no-wrap, fuzzy
msgid "Port specific qmake flags to be passed to the `qmake` binary."
msgstr "传递给 `qmake` 二进制文件的 Port 专用标志。"

#. type: Table
#: documentation/content/en/books/porters-handbook/special/_index.adoc:2490
#, no-wrap, fuzzy
msgid "`QMAKE_ENV`"
