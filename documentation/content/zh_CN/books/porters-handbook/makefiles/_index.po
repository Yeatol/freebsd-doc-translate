"MASTER_SITES=\t\t${MASTER_SITE_GNU}\n"
"MASTER_SITE_SUBDIR=\tmake\n"
msgstr "MASTER_SITES=\t\t${MASTER_SITE_GNU}\nMASTER_SITE_SUBDIR=\tmake\n"

#. type: Plain text
