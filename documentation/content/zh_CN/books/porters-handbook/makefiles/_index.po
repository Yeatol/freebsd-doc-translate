".if ${PORT_OPTIONS:MOPT2}\n"
"ALSO_BUILD+=\tbin2\n"
".endif\n"
msgstr ".if ${PORT_OPTIONS:MOPT2}\nALSO_BUILD+=\tbin2\n.endif\n"

#. type: delimited block . 4
#: documentation/content/en/books/porters-handbook/makefiles/_index.adoc:4795
#, no-wrap, fuzzy
