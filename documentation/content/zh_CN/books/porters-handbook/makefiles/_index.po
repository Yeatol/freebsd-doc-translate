#. type: delimited block . 4
#: documentation/content/en/books/porters-handbook/makefiles/_index.adoc:4649
#, no-wrap, fuzzy
msgid ""
"OPT1_CONFIGURE_ENABLE=\topt1\n"
"OPT2_CONFIGURE_ENABLE=\topt2\n"
