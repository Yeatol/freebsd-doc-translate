msgstr "PORTNAME=       libworkman\nPORTVERSION=    1.4\nCATEGORIES=     audio\nMASTER_SITES=   LOCAL/jim\nDISTNAME=       ${PORTNAME}-1999-06-20\n"

#. type: Block title
#: documentation/content/en/books/porters-handbook/makefiles/_index.adoc:1224
#, no-wrap, fuzzy
msgid "Exotic Case 2"
msgstr "特殊情况 2"

#. type: delimited block = 4
#: documentation/content/en/books/porters-handbook/makefiles/_index.adoc:1229
#, fuzzy
msgid ""
"In package:comms/librs232[], the distribution file is not versioned, so "
"using crossref:makefiles[makefile-dist_subdir,`DIST_SUBDIR`] is needed:"
