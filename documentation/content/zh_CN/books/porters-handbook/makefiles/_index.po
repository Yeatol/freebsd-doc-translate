#. type: Title =====
#: documentation/content/en/books/porters-handbook/makefiles/_index.adoc:4576
#, no-wrap, fuzzy
msgid "`OPT_MESON_ENABLED` and `OPT_MESON_DISABLED`"
msgstr "`OPT_MESON_ENABLED` 和 `OPT_MESON_DISABLED`"

#. type: Plain text
#: documentation/content/en/books/porters-handbook/makefiles/_index.adoc:4582
#, fuzzy
msgid ""
"When option _OPT_ is selected, for each _entry_ in `OPT_MESON_ENABLED` then "
"`-D__entry__=enabled` is appended to `MESON_ARGS`.  When option _OPT_ is "
"_not_ selected, `-D__entry__=disabled` is appended to `MESON_ARGS`.  "
"`OPT_MESON_DISABLED` is the opposite, `-D__entry__=disabled` is appended to "
"`MESON_ARGS` when the option is selected, and `-D__entry__=enabled` when the "
"option is _not_ selected.  For example:"
msgstr "选择选项 __OPT__ 时，`OPT_MESON_ENABLED` 中的每个 _entry_ 都会使 `-D__entry__=enabled` 附加到 `MESON_ARGS`。未选择选项 __OPT__ 时，则会附加 `-D__entry__=disabled`。`OPT_MESON_DISABLED` 的作用相反：选择该选项时，`-D__entry__=disabled` 会附加到 `MESON_ARGS`；未选择该选项时，则附加 `-D__entry__=enabled`。例如："

#. type: delimited block . 4
#: documentation/content/en/books/porters-handbook/makefiles/_index.adoc:4588
#, no-wrap, fuzzy
msgid ""
"OPTIONS_DEFINE=\tOPT1\n"
"OPT1_MESON_ENABLED=\ttest\n"
"OPT1_MESON_DISABLED=\tdebug\n"
msgstr "OPTIONS_DEFINE=\tOPT1\nOPT1_MESON_ENABLED=\ttest\nOPT1_MESON_DISABLED=\tdebug\n"

#. type: delimited block . 4
#: documentation/content/en/books/porters-handbook/makefiles/_index.adoc:4603
#, no-wrap, fuzzy
msgid ""
".if ${PORT_OPTIONS:MOPT1}\n"
"MESON_ARGS+=\t-Dtest=enabled -Ddebug=disabled\n"
".else\n"
"MESON_ARGS+=\t-Dtest=disabled -Ddebug=enabled\n"
".endif\n"
msgstr ".if ${PORT_OPTIONS:MOPT1}\nMESON_ARGS+=\t-Dtest=enabled -Ddebug=disabled\n.else\nMESON_ARGS+=\t-Dtest=disabled -Ddebug=enabled\n.endif\n"

#. type: Title ====
#: documentation/content/en/books/porters-handbook/makefiles/_index.adoc:4606
#, no-wrap, fuzzy
msgid "`OPT_QMAKE_ON` and `OPT_QMAKE_OFF`"
msgstr "`OPT_QMAKE_ON` 和 `OPT_QMAKE_OFF`"

#. type: Plain text
