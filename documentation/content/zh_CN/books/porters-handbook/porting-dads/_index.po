".endif\n"
msgstr "# no need to compile lang/perl5 if perl5 is already in system\n.if ${OSVERSION} > 300003\nBROKEN=\tperl is in system\n.endif\n"

#. type: Plain text
#: documentation/content/en/books/porters-handbook/porting-dads/_index.adoc:156
#, fuzzy
