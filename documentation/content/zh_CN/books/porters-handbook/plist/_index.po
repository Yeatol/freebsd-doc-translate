"filename]#Makefile#."
msgstr "请勿单独使用。如果 port 安装 [.filename]#*.terminfo# 文件，请在其 [.filename]#Makefile# 中添加 crossref:uses[uses-terminfo,`USES=terminfo`]。"

#. type: delimited block = 4
