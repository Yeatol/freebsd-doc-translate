#. type: delimited block . 4
#: documentation/content/en/books/accessibility/colors/_index.adoc:577
#, no-wrap, fuzzy
msgid "# kldload acpi_video\n"
msgstr "# kldload acpi_video\n"

#. type: Plain text
#: documentation/content/en/books/accessibility/colors/_index.adoc:581
#, fuzzy
msgid ""
"Brightness settings can be configured using extref:{handbook}config/"
"#configtuning-sysctl[sysctl(8)].  The following parameters are available:"
