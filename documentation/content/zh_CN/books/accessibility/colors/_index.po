#: documentation/content/en/books/accessibility/colors/_index.adoc:157
#, no-wrap, fuzzy
msgid ""
"# pkg search zip <1>\n"
"% unzip Treepata.zip <2>\n"
"% mkdir ~/.icons <3>\n"
"% cp -a Treepata ~/.icons/ <4>\n"
"% rm Treepata.zip <5>\n"
"% xfconf-query -c xsettings -p /Net/IconThemeName -s Treepata <6>\n"
msgstr "# pkg search zip <1>\n% unzip Treepata.zip <2>\n% mkdir ~/.icons <3>\n% cp -a Treepata ~/.icons/ <4>\n% rm Treepata.zip <5>\n% xfconf-query -c xsettings -p /Net/IconThemeName -s Treepata <6>\n"

