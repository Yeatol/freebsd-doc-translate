#. type: delimited block . 4
#: documentation/content/en/books/accessibility/blindness/_index.adoc:241
#, no-wrap, fuzzy
msgid "# pkg install festvox-kal16\n"
msgstr "# pkg install festvox-kal16\n"

#. type: Plain text
