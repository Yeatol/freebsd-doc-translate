#. type: delimited block . 4
#: documentation/content/en/books/handbook/printing/_index.adoc:822
#, no-wrap, fuzzy
msgid "lp|repairsprinter|salesprinter:\\\n"
msgstr "lp|repairsprinter|salesprinter:\\\n"

