msgstr "vo=gpu-next<.>\ngpu-context=wayland<.>\nhwdec=auto<.>\nscreenshot-jpeg-quality=100\nscale=ewa_lanczos4sharpest<.>\ndscale=ewa_lanczos4sharpest\n"

