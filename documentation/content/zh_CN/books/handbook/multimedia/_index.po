#: documentation/content/en/books/handbook/multimedia/_index.adoc:455
#, fuzzy
msgid "Here is a short sample [filename.]#~/.config/mpv/mpv.conf#"
msgstr "以下是一个简短的 [filename.]#~/.config/mpv/mpv.conf# 示例"

