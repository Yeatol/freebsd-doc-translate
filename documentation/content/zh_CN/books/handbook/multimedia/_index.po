#, fuzzy
msgid ""
"The man:webcamd[8] service must be started by executing the following "
"command:"
msgstr "必须执行以下命令启动 man:webcamd[8] 服务："

#. type: delimited block . 4
#: documentation/content/en/books/handbook/multimedia/_index.adoc:623
#, no-wrap, fuzzy
msgid "# service webcamd start\n"
msgstr "# service webcamd start\n"

#. type: delimited block . 4
#: documentation/content/en/books/handbook/multimedia/_index.adoc:631
#, no-wrap, fuzzy
msgid ""
"Starting webcamd.\n"
"webcamd 1616 - - Attached to ugen0.2[0]\n"
msgstr "Starting webcamd.\nwebcamd 1616 - - Attached to ugen0.2[0]\n"

