"[...]\n"
msgstr "[...]\nJul 16 12:40:00 FreeBSD /usr/sbin/cron[81519]: (root) CMD (/usr/libexec/atrun)\nJul 16 12:44:00 FreeBSD /usr/sbin/cron[83072]: (operator) CMD (/usr/libexec/save-entropy)\n[...]\n"

#. type: Plain text
#: documentation/content/en/books/handbook/config/_index.adoc:899
