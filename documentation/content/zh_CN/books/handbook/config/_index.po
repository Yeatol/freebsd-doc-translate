#: documentation/content/en/books/handbook/config/_index.adoc:1238
#, no-wrap, fuzzy
msgid "acpi_ibm_load=\"YES\"\n"
msgstr "acpi_ibm_load=\"YES\"\n"

#. type: Plain text
#: documentation/content/en/books/handbook/config/_index.adoc:1246
#, fuzzy
msgid ""
"An alternative to the man:acpi_video[4] module is the man:backlight[9] "
"driver.  It provides a generic way for handling a panel backlight.  The "
"default GENERIC kernel includes this driver.  The man:backlight[8] utility "
"can be used to query and adjust the brightness of the panel backlight.  In "
"this example the brightness is decreased by 10%:"
msgstr "man:backlight[9] 驱动程序可作为 man:acpi_video[4] 模块的替代方案。它提供了通用的面板背光处理方式。默认的 GENERIC 内核包含此驱动程序。可以使用 man:backlight[8] 实用程序查询和调整面板背光亮度。以下示例将亮度降低 10%："

#. type: delimited block . 4
#: documentation/content/en/books/handbook/config/_index.adoc:1250
#, no-wrap, fuzzy
msgid "% backlight decr 10\n"
msgstr "% backlight decr 10\n"

#. type: Title ===
#: documentation/content/en/books/handbook/config/_index.adoc:1253
#, fuzzy, no-wrap
