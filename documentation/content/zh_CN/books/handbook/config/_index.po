msgid ""
"acpi_asus.ko\n"
"acpi_asus_wmi.ko\n"
"acpi_dock.ko\n"
"acpi_fujitsu.ko\n"
"acpi_hp.ko\n"
"acpi_ibm.ko\n"
"acpi_panasonic.ko\n"
"acpi_sony.ko\n"
"acpi_toshiba.ko\n"
"acpi_video.ko\n"
"acpi_wmi.ko\n"
"sdhci_acpi.ko\n"
"uacpi.ko\n"
msgstr "acpi_asus.ko\nacpi_asus_wmi.ko\nacpi_dock.ko\nacpi_fujitsu.ko\nacpi_hp.ko\nacpi_ibm.ko\nacpi_panasonic.ko\nacpi_sony.ko\nacpi_toshiba.ko\nacpi_video.ko\nacpi_wmi.ko\nsdhci_acpi.ko\nuacpi.ko\n"

#. type: Plain text
#: documentation/content/en/books/handbook/config/_index.adoc:1227
#, fuzzy
msgid ""
"In the event that, for example, an IBM/Lenovo laptop is used, it will be "
"necessary to load the module man:acpi_ibm[4] by executing the following "
"command:"
msgstr "例如，使用 IBM/Lenovo 笔记本电脑时，需要执行以下命令加载 man:acpi_ibm[4] 模块："

#. type: delimited block . 4
#: documentation/content/en/books/handbook/config/_index.adoc:1231
#, no-wrap, fuzzy
msgid "# kldload acpi_ibm\n"
msgstr "# kldload acpi_ibm\n"

#. type: Plain text
#: documentation/content/en/books/handbook/config/_index.adoc:1234
#, fuzzy
msgid "And add this line to [.filename]#/boot/loader.conf# to load it at boot:"
msgstr "并将此行添加到 [.filename]#/boot/loader.conf#，以便在启动时加载该模块："

