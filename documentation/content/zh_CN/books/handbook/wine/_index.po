msgstr "新的替代项将显示在 _Existing overrides_ 列表中；请注意括号中的 _native, builtin_ 标记。"

#. type: Plain text
#: documentation/content/en/books/handbook/wine/_index.adoc:417
msgid "Click to select the library."
msgstr "点击要选择的库。"

#. type: Plain text
#: documentation/content/en/books/handbook/wine/_index.adoc:418
#, fuzzy
msgid "Click the _Edit_ button."
msgstr "单击 _Edit_ 按钮。"

#. type: Plain text
#: documentation/content/en/books/handbook/wine/_index.adoc:419
