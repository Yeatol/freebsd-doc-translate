msgstr "本例使用路径 [.filename]#/usr/local/jails/containers/vnet# 作为所创建 jail 的路径。"

#. type: Plain text
#: documentation/content/en/books/handbook/jails/_index.adoc:1098
#, fuzzy
msgid "The following is an example configuration for a VNET jail:"
msgstr "以下是 VNET jail 的配置示例："

#. type: delimited block . 4
#: documentation/content/en/books/handbook/jails/_index.adoc:1104
#, no-wrap, fuzzy
msgid ""
"vnet {\n"
"  # STARTUP/LOGGING\n"
"  exec.consolelog = \"/var/log/jail_console_${name}.log\";\n"
msgstr "vnet {\n  # STARTUP/LOGGING\n  exec.consolelog = \"/var/log/jail_console_${name}.log\";\n"

#. type: delimited block . 4
#: documentation/content/en/books/handbook/jails/_index.adoc:1110
#, no-wrap, fuzzy
msgid ""
"  # PERMISSIONS\n"
"  allow.raw_sockets;\n"
"  exec.clean;\n"
"  mount.devfs;\n"
"  devfs_ruleset = 5;\n"
msgstr "  # PERMISSIONS\n  allow.raw_sockets;\n  exec.clean;\n  mount.devfs;\n  devfs_ruleset = 5;\n"

#. type: delimited block . 4
#: documentation/content/en/books/handbook/jails/_index.adoc:1114
#, no-wrap, fuzzy
msgid ""
"  # PATH/HOSTNAME\n"
"  path = \"/usr/local/jails/containers/${name}\";\n"
"  host.hostname = \"${name}\";\n"
msgstr "  # PATH/HOSTNAME\n  path = \"/usr/local/jails/containers/${name}\";\n  host.hostname = \"${name}\";\n"

#. type: delimited block . 4
#: documentation/content/en/books/handbook/jails/_index.adoc:1118
#, no-wrap, fuzzy
msgid ""
"  # VNET/VIMAGE\n"
"  vnet;\n"
"  vnet.interface = \"${epair}b\";\n"
msgstr "  # VNET/VIMAGE\n  vnet;\n  vnet.interface = \"${epair}b\";\n"

#. type: delimited block . 4
#: documentation/content/en/books/handbook/jails/_index.adoc:1125
#, no-wrap, fuzzy
msgid ""
"  # NETWORKS/INTERFACES\n"
"  $id = \"154\"; <.>\n"
"  $ip = \"192.168.1.${id}/24\";\n"
"  $gateway = \"192.168.1.1\";\n"
"  $bridge = \"bridge0\"; <.>\n"
"  $epair = \"epair${id}\";\n"
msgstr "  # NETWORKS/INTERFACES\n  $id = \"154\"; <.>\n  $ip = \"192.168.1.${id}/24\";\n  $gateway = \"192.168.1.1\";\n  $bridge = \"bridge0\"; <.>\n  $epair = \"epair${id}\";\n"

#. type: delimited block . 4
#: documentation/content/en/books/handbook/jails/_index.adoc:1137
#, no-wrap, fuzzy
msgid ""
"  # ADD TO bridge INTERFACE\n"
"  exec.prestart  = \"/sbin/ifconfig ${epair} create up\";\n"
"  exec.prestart += \"/sbin/ifconfig ${epair}a up descr jail:${name}\";\n"
"  exec.prestart += \"/sbin/ifconfig ${bridge} addm ${epair}a up\";\n"
