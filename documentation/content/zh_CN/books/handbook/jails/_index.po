msgstr "`allow.quotas`"

#. type: Table
#: documentation/content/en/books/handbook/jails/_index.adoc:2162
#, no-wrap, fuzzy
msgid "The jail may administer filesystem quotas."
msgstr "Jail 可以管理文件系统配额。"

#. type: Table
#: documentation/content/en/books/handbook/jails/_index.adoc:2163
#, no-wrap, fuzzy
msgid "`allow.read_msgbuf`"
msgstr "`allow.read_msgbuf`"

#. type: Table
#: documentation/content/en/books/handbook/jails/_index.adoc:2166
#, no-wrap, fuzzy
msgid "Jailed processes may read the kernel message buffer with man:dmesg[8]."
msgstr "Jail 中的进程可以使用 man:dmesg[8] 读取内核消息缓冲区。"

#. type: Table
