msgstr "创建一个 [.filename]#device.map#，供 grub 用于将虚拟设备映射到主机系统上的文件："

#. type: delimited block . 4
#: documentation/content/en/books/handbook/virtualization/_index.adoc:1441
#, fuzzy, no-wrap
msgid ""
"(hd0) ./linux.img\n"
"(cd0) ./somelinux.iso\n"
msgstr ""
"(hd0) ./linux.img\n"
"(cd0) ./somelinux.iso\n"

#. type: Plain text
#: documentation/content/en/books/handbook/virtualization/_index.adoc:1444
