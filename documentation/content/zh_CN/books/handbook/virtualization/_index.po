msgstr "# cd /usr/ports/emulators/virtualbox-ose-additions && make install clean\n"

#. type: Plain text
#: documentation/content/en/books/handbook/virtualization/_index.adoc:323
#, fuzzy
msgid "Add these lines to [.filename]#/etc/rc.conf#:"
msgstr "将以下行添加到 [.filename]#/etc/rc.conf#："

#. type: delimited block . 4
