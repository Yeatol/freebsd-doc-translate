msgstr "# bhyve -A -H -P -s 0:0,hostbridge -s 1:0,lpc -s 2:0,virtio-net,tap0 \\\n    -s 3:0,virtio-blk,./linux.img -s 4:0,ahci-cd,./somelinux.iso \\\n    -l com1,stdio -c 4 -m 1024M linuxguest\n"

#. type: Plain text
#: documentation/content/en/books/handbook/virtualization/_index.adoc:1479
#, fuzzy
msgid ""
"The system will boot and start the installer.  After installing a system in "
