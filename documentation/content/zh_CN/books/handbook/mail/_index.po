msgstr "Mutt 电子邮件客户端显示摘要界面"

#. type: Target for macro image
#: documentation/content/en/books/handbook/mail/_index.adoc:638
#, no-wrap, fuzzy
msgid "mutt3.png"
msgstr "mutt3.png"

#. type: Plain text
#: documentation/content/en/books/handbook/mail/_index.adoc:642
#, fuzzy
