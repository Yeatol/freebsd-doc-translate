"   autoindex on;\n"
" }\n"
msgstr " location /FreeBSD:14:amd64 {\n   alias /usr/obj/usr/src/repo/FreeBSD:14:amd64/;\n   autoindex on;\n }\n"

#. type: Plain text
#: documentation/content/en/books/handbook/cutting-edge/_index.adoc:1455
#, fuzzy
msgid "And reload the nginx service."
msgstr "然后重新加载 nginx 服务。"

#. type: Plain text
#: documentation/content/en/books/handbook/cutting-edge/_index.adoc:1457
#, fuzzy
