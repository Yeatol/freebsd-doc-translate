#. type: delimited block . 4
#: documentation/content/en/books/handbook/zfs/_index.adoc:299
#, no-wrap, fuzzy
msgid "# zfs snapshot storage/home@2026-07-11\n"
msgstr "# zfs snapshot storage/home@2026-07-11\n"

#. type: Plain text
#: documentation/content/en/books/handbook/zfs/_index.adoc:302
#, fuzzy
#| msgid ""
#| "Snapshots can only be made of a full file system, not a single directory "
