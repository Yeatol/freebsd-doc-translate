msgstr "通用格式为 `userquota@_user_=_size_`，用户名称必须采用以下格式之一："

#. type: Plain text
#: documentation/content/en/books/handbook/zfs/_index.adoc:3225
#, fuzzy
msgid "POSIX compatible name such as _joe_."
msgstr "POSIX 兼容名称，例如 __joe__。"

#. type: Plain text
#: documentation/content/en/books/handbook/zfs/_index.adoc:3226
#, fuzzy
msgid "POSIX numeric ID such as _789_."
msgstr "POSIX 数字 ID，例如 __789__。"

#. type: Plain text
#: documentation/content/en/books/handbook/zfs/_index.adoc:3227
#, fuzzy
msgid "SID name such as _joe.bloggs@example.com_."
