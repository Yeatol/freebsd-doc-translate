#. type: delimited block . 4
#: documentation/content/en/books/handbook/zfs/_index.adoc:3264
#, no-wrap, fuzzy
msgid "# zfs set groupquota@firstgroup=none storage/home\n"
msgstr "# zfs set groupquota@firstgroup=none storage/home\n"

#. type: Plain text
#: documentation/content/en/books/handbook/zfs/_index.adoc:3268
#, fuzzy
msgid ""
"As with the user quota property, non-`root` users can see the quotas "
