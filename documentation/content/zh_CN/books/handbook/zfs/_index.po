#. type: delimited block . 4
#: documentation/content/en/books/handbook/zfs/_index.adoc:1129
#, no-wrap, fuzzy
msgid ""
"errors: No known data errors\n"
"# zpool status\n"
"  pool: mypool\n"
" state: ONLINE\n"
