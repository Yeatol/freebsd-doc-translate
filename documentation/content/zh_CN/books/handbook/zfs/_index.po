"# zpool status\n"
"  pool: mypool\n"
" state: ONLINE\n"
"config:\n"
msgstr "# zpool create mypool raidz2 /dev/ada0p1 /dev/ada1p1 /dev/ada2p1 /dev/ada3p1 /dev/ada4p1 /dev/ada5p1\n# zpool status\n  pool: mypool\n state: ONLINE\nconfig:\n"

