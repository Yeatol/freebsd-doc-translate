#, fuzzy, no-wrap
msgid "ftp     stream  tcp     nowait  root    /usr/libexec/ftpd       ftpd -l\n"
msgstr "ftp     stream  tcp     nowait  root    /usr/libexec/ftpd       ftpd -l\n"

