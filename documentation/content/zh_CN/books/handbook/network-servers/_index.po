#. type: delimited block . 4
#: documentation/content/en/books/handbook/network-servers/_index.adoc:1444
#, no-wrap, fuzzy
msgid ""
"dn: cn=schema,cn=config\n"
"objectClass: olcSchemaConfig\n"
"cn: schema\n"
msgstr "dn: cn=schema,cn=config\nobjectClass: olcSchemaConfig\ncn: schema\n"

#. type: delimited block . 4
