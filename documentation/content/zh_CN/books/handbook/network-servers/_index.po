#. type: delimited block . 4
#: documentation/content/en/books/handbook/network-servers/_index.adoc:1368
#, no-wrap, fuzzy
msgid "# openssl x509 -req -days 365 -in server.csr -out ../server.crt -CA ../ca.crt -CAkey ca.key -CAcreateserial\n"
msgstr "# openssl x509 -req -days 365 -in server.csr -out ../server.crt -CA ../ca.crt -CAkey ca.key -CAcreateserial\n"

#. type: Plain text
#: documentation/content/en/books/handbook/network-servers/_index.adoc:1371
msgid ""
