#, no-wrap, fuzzy
msgid "# openssl req -days 365 -nodes -new -keyout server.key -out server.csr\n"
msgstr "# openssl req -days 365 -nodes -new -keyout server.key -out server.csr\n"

#. type: Plain text
#: documentation/content/en/books/handbook/network-servers/_index.adoc:1364
#, fuzzy
msgid ""
"During the certificate generation process, be sure to correctly set the "
