msgstr "# Host name to use inside jails\nexport BUILDHOSTNAME=${HOSTPLATFORM}-builder.daemonology.net <.>\n"

#. type: delimited block . 4
#: documentation/content/en/articles/freebsd-update-server/_index.adoc:125
#, no-wrap, fuzzy
