#, no-wrap, fuzzy
msgid ""
"# sh scripts/init.sh amd64 7.2-RELEASE\n"
"Mon Aug 24 16:04:36 PDT 2009 Starting fetch for FreeBSD/amd64 7.2-RELEASE\n"
