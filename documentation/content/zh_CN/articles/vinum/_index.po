"Drives:         1 (4 configured)\n"
"Volumes:        1 (4 configured)\n"
"Plexes:         1 (8 configured)\n"
"Subdisks:       1 (16 configured)\n"
msgstr "#  gvinum -> create config1\nConfiguration summary\nDrives:         1 (4 configured)\nVolumes:        1 (4 configured)\nPlexes:         1 (8 configured)\nSubdisks:       1 (16 configured)\n"

#. type: delimited block . 4
