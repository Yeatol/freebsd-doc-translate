#. type: delimited block . 4
#: documentation/content/en/articles/nanobsd/_index.adoc:355
#, no-wrap, fuzzy
msgid ""
"CONF_BUILD='\n"
"WITHOUT_KLDLOAD=YES\n"
"WITHOUT_NETGRAPH=YES\n"
"WITHOUT_PAM=YES\n"
"'\n"
msgstr "CONF_BUILD='\nWITHOUT_KLDLOAD=YES\nWITHOUT_NETGRAPH=YES\nWITHOUT_PAM=YES\n'\n"

#. type: delimited block . 4
#: documentation/content/en/articles/nanobsd/_index.adoc:371
#, no-wrap, fuzzy
msgid ""
"CONF_INSTALL='\n"
"WITHOUT_ACPI=YES\n"
"WITHOUT_BLUETOOTH=YES\n"
"WITHOUT_FORTRAN=YES\n"
"WITHOUT_HTML=YES\n"
"WITHOUT_LPR=YES\n"
"WITHOUT_MAN=YES\n"
"WITHOUT_SENDMAIL=YES\n"
"WITHOUT_SHAREDOCS=YES\n"
"WITHOUT_EXAMPLES=YES\n"
"WITHOUT_INSTALLLIB=YES\n"
"WITHOUT_CALENDAR=YES\n"
"WITHOUT_MISC=YES\n"
"WITHOUT_SHARE=YES\n"
"'\n"
msgstr "CONF_INSTALL='\nWITHOUT_ACPI=YES\nWITHOUT_BLUETOOTH=YES\nWITHOUT_FORTRAN=YES\nWITHOUT_HTML=YES\nWITHOUT_LPR=YES\nWITHOUT_MAN=YES\nWITHOUT_SENDMAIL=YES\nWITHOUT_SHAREDOCS=YES\nWITHOUT_EXAMPLES=YES\nWITHOUT_INSTALLLIB=YES\nWITHOUT_CALENDAR=YES\nWITHOUT_MISC=YES\nWITHOUT_SHARE=YES\n'\n"

#. type: delimited block . 4
#: documentation/content/en/articles/nanobsd/_index.adoc:382
#, no-wrap, fuzzy
msgid ""
"CONF_WORLD='\n"
"WITHOUT_BIND=YES\n"
"WITHOUT_MODULES=YES\n"
"WITHOUT_KERBEROS=YES\n"
"WITHOUT_GAMES=YES\n"
"WITHOUT_RESCUE=YES\n"
"WITHOUT_LOCALES=YES\n"
"WITHOUT_SYSCONS=YES\n"
"WITHOUT_INFO=YES\n"
"'\n"
msgstr "CONF_WORLD='\nWITHOUT_BIND=YES\nWITHOUT_MODULES=YES\nWITHOUT_KERBEROS=YES\nWITHOUT_GAMES=YES\nWITHOUT_RESCUE=YES\nWITHOUT_LOCALES=YES\nWITHOUT_SYSCONS=YES\nWITHOUT_INFO=YES\n'\n"

#. type: delimited block . 4
#: documentation/content/en/articles/nanobsd/_index.adoc:384
#, no-wrap, fuzzy
msgid "FlashDevice SanDisk 1G\n"
msgstr "FlashDevice SanDisk 1G\n"

#. type: delimited block . 4
#: documentation/content/en/articles/nanobsd/_index.adoc:389
#, no-wrap, fuzzy
msgid ""
"cust_nobeastie() (\n"
"\ttouch ${NANO_WORLDDIR}/boot/loader.conf\n"
"\techo \"beastie_disable=\\\"YES\\\"\" >> ${NANO_WORLDDIR}/boot/loader.conf\n"
")\n"
msgstr "cust_nobeastie() (\n\ttouch ${NANO_WORLDDIR}/boot/loader.conf\n\techo \"beastie_disable=\\\"YES\\\"\" >> ${NANO_WORLDDIR}/boot/loader.conf\n)\n"

#. type: delimited block . 4
#: documentation/content/en/articles/nanobsd/_index.adoc:394
#, no-wrap, fuzzy
