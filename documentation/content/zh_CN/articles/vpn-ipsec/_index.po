#. type: delimited block . 4
#: documentation/content/en/articles/vpn-ipsec/_index.adoc:133
#, no-wrap, fuzzy
msgid ""
"corp-gw# route add 10.0.0.0 10.0.0.5 255.255.255.0\n"
"corp-gw# route add net 10.0.0.0: gateway 10.0.0.5\n"
"home-gw# route add 10.246.38.0 10.246.38.1 255.255.255.0\n"
"home-gw# route add host 10.246.38.0: gateway 10.246.38.1\n"
msgstr "corp-gw# route add 10.0.0.0 10.0.0.5 255.255.255.0\ncorp-gw# route add net 10.0.0.0: gateway 10.0.0.5\nhome-gw# route add 10.246.38.0 10.246.38.1 255.255.255.0\nhome-gw# route add host 10.246.38.0: gateway 10.246.38.1\n"

