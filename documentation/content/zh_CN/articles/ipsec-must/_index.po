#. type: delimited block . 4
#: documentation/content/en/articles/ipsec-must/_index.adoc:214
#, no-wrap, fuzzy
msgid ""
"int main(argc, argv)\n"
"int argc;\n"
"char **argv;\n"
"{\n"
"  FILE *fptr;\n"
"  int i,j;\n"
"  int b, c;\n"
"  int table[V];\n"
"  double sum = 0.0;\n"
"  int iproduct = 1;\n"
