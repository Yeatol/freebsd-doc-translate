msgstr "int main(argc, argv)\nint argc;\nchar **argv;\n{\n  FILE *fptr;\n  int i,j;\n  int b, c;\n  int table[V];\n  double sum = 0.0;\n  int iproduct = 1;\n  int run;\n"

#. type: delimited block . 4
#: documentation/content/en/articles/ipsec-must/_index.adoc:216
#, no-wrap, fuzzy
