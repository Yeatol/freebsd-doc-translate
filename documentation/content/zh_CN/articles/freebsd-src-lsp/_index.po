msgstr "au User lsp_setup call lsp#register_server({\n    \\ 'name': 'ccls',\n    \\ 'cmd': {server_info->['ccls']},\n    \\ 'allowlist': ['c', 'cpp', 'objc'],\n    \\ 'initialization_options': {\n    \\     'cache': {\n    \\         'hierarchicalPath': v:true\n    \\     }\n    \\ }})\n"

